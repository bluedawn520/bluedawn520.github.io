---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="归档 | BlueDawn's Blog" description="全部文章归档">
	<div class="max-w-3xl mx-auto">
		<div class="space-y-8">
			{posts.map((post) => (
				<article class="border-b border-gray-200 dark:border-gray-700 pb-8">
					<div class="text-sm text-gray-500 dark:text-gray-400 mb-2">
						<time>{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
					</div>
					<h1 class="text-2xl font-bold mb-2">
						<a href={`/blog/${post.slug}/`} class="hover:text-primary-600 transition-colors">{post.data.title}</a>
					</h1>
					<p class="text-gray-600 dark:text-gray-400">{post.data.description}</p>
				</article>
			))}
		</div>
	</div>
</Layout>
