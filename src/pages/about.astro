---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const totalPosts = posts.length;
---

<Layout title="关于 | 不羁" description="关于不羁的技术博客">
	<div class="max-w-2xl mx-auto">
		<!-- Profile Card -->
		<div class="text-center mb-12">
			<img
				src="/images/avatar.gif"
				alt="blue_dawn 头像"
				class="w-28 h-28 rounded-full mx-auto mb-6 shadow-lg ring-4 ring-primary-100 dark:ring-primary-900 object-cover"
			/>
			<h1 class="text-3xl font-bold mb-2">不羁</h1>
			<p class="text-gray-500 dark:text-gray-500 italic">"仰天大笑出门去，我辈岂是蓬蒿人"</p>
			<p class="text-sm text-gray-400 dark:text-gray-600 mt-2">清风徐来，水波不兴</p>
		</div>

		<!-- About Content -->
		<div class="prose dark:prose-invert max-w-none space-y-10">
			<!-- Stats -->
			<div class="grid grid-cols-3 gap-4 not-prose">
				<div class="text-center p-4 rounded-xl bg-gray-50 dark:bg-gray-800">
					<div class="text-2xl font-bold text-primary-600">{totalPosts}</div>
					<div class="text-sm text-gray-500 dark:text-gray-400">文章</div>
				</div>
				<div class="text-center p-4 rounded-xl bg-gray-50 dark:bg-gray-800">
					<div class="text-2xl font-bold text-primary-600">17</div>
					<div class="text-sm text-gray-500 dark:text-gray-400">标签</div>
				</div>
				<div class="text-center p-4 rounded-xl bg-gray-50 dark:bg-gray-800">
					<div class="text-2xl font-bold text-primary-600">2020</div>
					<div class="text-sm text-gray-500 dark:text-gray-400">始于</div>
				</div>
			</div>

			<section>
				<h2>关于这个博客</h2>
				<p>
					这里记录了我的学习过程，包括编程、考研复习、英语学习和工程实践。
					主要涵盖了 C/C++、数据结构、操作系统、算法研究等内容。
					博客始建于 2020 年，最初使用 Hexo + NexT 主题搭建，
					后迁移至 Astro 以追求更快的构建速度和更好的开发体验。
				</p>
			</section>

			<section>
				<h2>内容分类</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 not-prose">
					<div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800">
						<div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
						</div>
						<div>
							<div class="font-medium">编程</div>
							<div class="text-sm text-gray-500 dark:text-gray-400">C/C++ 学习笔记、代码实践</div>
						</div>
					</div>
					<div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800">
						<div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900 flex items-center justify-center text-purple-600 dark:text-purple-400 shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
						</div>
						<div>
							<div class="font-medium">研究阅读</div>
							<div class="text-sm text-gray-500 dark:text-gray-400">遗传算法、SAT 问题、文献阅读</div>
						</div>
					</div>
					<div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800">
						<div class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900 flex items-center justify-center text-green-600 dark:text-green-400 shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
						</div>
						<div>
							<div class="font-medium">英语学习</div>
							<div class="text-sm text-gray-500 dark:text-gray-400">CGTN 泛读、晨读、考研英语</div>
						</div>
					</div>
					<div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800">
						<div class="w-8 h-8 rounded-lg bg-orange-100 dark:bg-orange-900 flex items-center justify-center text-orange-600 dark:text-orange-400 shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.1-3.1a6 6 0 0 1-7.9 7.9l-5.6 5.6a2.1 2.1 0 0 1-3-3l5.6-5.6a6 6 0 0 1 7.9-7.9l-3.1 3.1Z"/></svg>
						</div>
						<div>
							<div class="font-medium">工程记录</div>
							<div class="text-sm text-gray-500 dark:text-gray-400">项目实践、工具使用</div>
						</div>
					</div>
				</div>
			</section>

			<section>
				<h2>联系方式</h2>
				<div class="flex flex-wrap gap-3 not-prose">
					<a href="https://github.com/bluedawn520" target="_blank" rel="noreferrer"
						class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-primary-100 dark:hover:bg-primary-900 transition-colors text-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						GitHub
					</a>
					<a href="mailto:2515294061@qq.com"
						class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-primary-100 dark:hover:bg-primary-900 transition-colors text-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
						Email
					</a>
					<span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-sm cursor-default">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
						QQ: 2515294061
					</span>
				</div>
			</section>

			<section>
				<h2>推荐阅读</h2>
				<ul>
					<li><a href="http://www.alloyteam.com/nav/" target="_blank" rel="noreferrer">Web 前端导航</a></li>
					<li><a href="http://www.chuangzaoshi.com/code" target="_blank" rel="noreferrer">创造狮导航</a></li>
					<li><a href="http://www.36zhen.com/t?id=3448" target="_blank" rel="noreferrer">前端书籍资料</a></li>
					<li><a href="https://www.v2ex.com/" target="_blank" rel="noreferrer">V2EX</a></li>
				</ul>
			</section>
		</div>
	</div>
</Layout>
